[Unit]
Description=StreamDock daemon (web control UI + device driver)
Documentation=https://github.com/MiraboxSpace/StreamDock-Device-SDK
Wants=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/streamdockd
Restart=on-failure
RestartSec=3

# Set deterministic runtime/session defaults for user services.
Environment=XDG_RUNTIME_DIR=%t
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus

# Pass the graphical session environment so button commands can launch
# GUI apps (Wayland/X11, D-Bus, etc.)
# HYPRLAND_INSTANCE_SIGNATURE and XDG_CURRENT_DESKTOP are required for
# Hyprland sessions (import them from Hyprland config with:
#   exec-once = systemctl --user import-environment WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE XDG_CURRENT_DESKTOP)
PassEnvironment=DISPLAY WAYLAND_DISPLAY DBUS_SESSION_BUS_ADDRESS XDG_RUNTIME_DIR XAUTHORITY HYPRLAND_INSTANCE_SIGNATURE XDG_CURRENT_DESKTOP

# libtransport.so writes Temporary.jpg relative to cwd.
# RuntimeDirectory creates /run/user/<uid>/streamdockd (writable, cleaned on stop).
RuntimeDirectory=streamdockd
RuntimeDirectoryMode=0700

# Sandboxing — keep what's safe, drop ProtectSystem strict since
# the precompiled .so writes to cwd (which is now the runtime dir above).
PrivateTmp=true
# Keep privilege restrictions compatible with Electron/Chromium app launchers
# (Obsidian, VS Code, Spotify), which may require sandbox setup in child process.
NoNewPrivileges=false

[Install]
# graphical-session.target is preferred (GNOME/KDE activate it automatically).
# default.target is the fallback for Hyprland and other compositors that do
# not activate graphical-session.target; the daemon tolerates early startup
# by continuously polling for the device until it appears.
WantedBy=graphical-session.target default.target
